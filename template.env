# Les variable qui ne sont pas explicitement obligatoires sont optionnelles

# Répertoire racine du projet (par défaut : le répertoire de decp-processing)
# "DECP_BASE_DIR=

# URI de connexion à POSGRESQL
# PREFECT_API_DATABASE_CONNECTION_URL="postgresql+asyncpg://postgres:yourTopSecretPassword@localhost:5432/prefect

# Level des logs (défaut : "INFO")
# LOG_LEVEL=

# Liste des datasets à traiter par decp-processing (défaut : reference/source_datasets.json)
# DATASETS_REFERENCE_FILEPATH=

# Le dossier où seront stockées les données téléchargées. Défaut : DECP_BASE_DIR/data
# Si vide, laissé commenté
# DECP_DATA_DIR=

# Chemin de dossier local où enregistrer les données produites en local
# Par défaut DECP_BASE_DIR/dist
# Si vide, laissé commenté
# DECP_DIST_DIR=

# Activer ou non la publication du résultat sur data.gouv.fr (src/tasks/publish.py)
# Mettre True pour l'activer
DECP_PROCESSING_PUBLISH=False

# La clé API se trouve dans votre compte data.gouv.fr. Utilisée pour publier les données produites.
# DATAGOUVFR_API_KEY=

# Le dossier où seront stockées les données SIRENE téléchargées (un dossier par mois). Défaut: DECP_DATA_DIR
# SIRENE_DATA_PARENT_DIR=

# L'URL à laquelle télécharger le parquet des unités légales et établissements (Stock pas historique)
SIRENE_UNITES_LEGALES_URL=https://www.data.gouv.fr/api/1/datasets/r/350182c9-148a-46e0-8389-76c2ec1374a3
SIRENE_ETABLISSEMENTS_URL=https://www.data.gouv.fr/api/1/datasets/r/a29c1297-1f92-4e2a-8f6b-8c902ce96c5f

# Les deux ressources du jeu de données « Données des entreprises utilisées dans
# l'Annuaire des Entreprises », dont sont tirés tous les labels d'entreprise.
# Unités légales (Parquet, clé SIREN) : ESS, association, Qualiopi, SIAE,
# avocat, achats responsables.
ANNUAIRE_UNITES_LEGALES_URL=https://www.data.gouv.fr/api/1/datasets/r/77f09ee6-8ccb-4eb8-ad10-382be6416065
# Établissements (Parquet, clé SIRET) : Bio et RGE.
ANNUAIRE_ETABLISSEMENTS_URL=https://www.data.gouv.fr/api/1/datasets/r/58427078-8afb-4651-9469-c9043991d892

# Population des communes (Datactivist), téléchargée à chaque exécution pour la
# détection des montants anormaux. Défaut : permalien data.gouv.fr ci-dessous.
# POPULATION_COMMUNES_URL=https://www.data.gouv.fr/api/1/datasets/r/863a5d6f-cc5c-40e0-a349-8a15719cb25e
# Chemin de la copie locale. Défaut : DECP_DATA_DIR/identifiants-communes.csv
# POPULATION_COMMUNES_CSV=

# L'adresse de l'API Prefect de production
# (pour les tests (pytest), laisser cette variable vide, un serveur temporaire sera créé en local)
PREFECT_API_URL=

# Clé API pour se connecter au serveur prefect de production
PREFECT_API_AUTH_STRING=

# Dossier de stockage des résultats de tâches et du cache Prefect
# Défaut : $PREFECT_HOME/storage, soit /home/$USER/.prefect/storage
# PREFECT_LOCAL_STORAGE_PATH=

# Nombre maximal de workers utilisables par Prefect. Défaut : 4
# MAX_PREFECT_WORKERS=

# Durée avant l'expiration du cache des ressources (en heure). Défaut : 168 (7 jours)
# CACHE_EXPIRATION_TIME_HOURS="168"

# Seuils de détection d'anomalies de montants (Signal A)
# ANOMALY_PAIRS_SUSPECT_THRESHOLD="4.0"
# ANOMALY_PAIRS_ABERRANT_THRESHOLD="6.0"
# ANOMALY_GROUPE_MIN_SIZE="30"

# POSTGRESQL output
# Si vous ne souhaitez pas sauvegarder dans POSTGRESQL, ne pas modifier cette valeur
# La base de données doit être créée auparavant
POSTGRESQL_DB_URI="postgresql://user:pass@server:port/database"

# Pour ignorer le cache mettre "false"
DECP_USE_CACHE="true"

# Timeout pour la publication de chaque ressource sur data.gouv.fr. Défaut : 300 (5 minutes)
# DECP_PROCESSING_PUBLISH_TIMEOUT=

# Mode de scraping
#- all : toutes les années de 2018 à aujourd'hui
#- month : juste les données du mois en cours (valeur par défaut)
#- year juste les données du mois en cours
# SCRAPING_MODE=

# Identifiants de ressources data.gouv.fr exclues du traitement
# séparés par des virgules
# EXCLUDED_RESOURCES=

# Ne traiter que ces dataset (par leur ID séparés par des virgules, sans espaces)
# SOLO_DATASETS=

# Configuration pour la publication vers un service S3-compatible (publish_to_s3)
# La publication est gatée par DECP_PROCESSING_PUBLISH (idem data.gouv.fr).
# Les 5 variables ci-dessous sont obligatoires si publish_to_s3() est appelée.
# S3_ENDPOINT_URL=https://s3.example.com
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=

# API de géocodage Géoplateforme
GEOCODING_API_URL=https://data.geopf.fr/geocodage
GEOCODING_MIN_SCORE=0.5
GEOCODING_RETRY_DAYS=30
GEOCODING_CHUNK_SIZE=5000

# === Serveur éphémère Scaleway (issue #189) ===
# Identifiants Scaleway (SDK scaleway ; voir https://console.scaleway.com/iam/api-keys)
# SCW_ACCESS_KEY=
# SCW_SECRET_KEY=
# SCW_DEFAULT_PROJECT_ID=
# SCW_DEFAULT_ZONE=fr-par-1

# Clé privée SSH du serveur actuel, utilisée pour se connecter à l'instance éphémère
# SCALEWAY_SSH_KEY_PATH=~/.ssh/id_ed25519

# Clé publique correspondante, injectée dans le user-data de l'instance éphémère.
# Par défaut : le fichier .pub voisin de la clé privée.
# SCALEWAY_SSH_PUBLIC_KEY_PATH=~/.ssh/id_ed25519.pub

# BOAMP / eForms (source de deao_processing) — issue #174
BOAMP_START_DATE=2024-01-01
BOAMP_RECRAWL_DAYS=3

# DEAO (flow deao_processing) — issue #178
DEAO_OPEN_DATASET_ID=6a26929bee84b87c37602925
DEAO_CLOSED_DATASET_ID=6af5c52094447e949d27b452
DEAO_CLOSED_PARQUET_RESOURCE_ID=b86dd1f4-68f5-4847-9a25-c6d234aa3d66
# SOLO_DEAO_SCRAPS=
# DEAO_SOURCES_REFERENCE_FILEPATH=reference/deao_sources.yaml
DEAO_PARQUET_RESOURCE_ID=8de01622-676d-47b1-a4d5-88fb3ccea161
DEAO_CSV_RESOURCE_ID=df846468-6748-46cd-a6ff-d84a065efa10
DEAO_SCHEMA_RESOURCE_ID=c02f36c5-2b7c-44c8-8ae1-9a722d91fabc
DEAO_STATUT_DELAI_JOURS=90
DEAO_MIN_ROWS_TO_PUBLISH=50000
DEAO_REBUILD=false
DEAO_SOURCES=boamp,joue
# BOAMP_S3_PREFIX=boamp/raw
# DEAO_GEOCODE_S3_PREFIX=deao
# Scrapers des plateformes Atexo (Mégalis Bretagne, Maximilien) — facultatives.
# Intervalle minimal (s) entre deux requêtes vers une même plateforme, User-Agent,
# préfixe S3 des DCE archivés, et reprise à zéro (état précédent ignoré).
# CLOSED_INTERVALLE_REQUETES_S=0.2
# CLOSED_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64; rv:140.0) Gecko/20100101 Firefox/140.0
# DEAO_DCE_S3_PREFIX=dce
# Base des URL publiques des DCE si elle diffère de <S3_ENDPOINT_URL>/<S3_BUCKET>
# (stockage multi-locataire), ex. https://s3.fr1.next.ink/<compte>:<bucket>
# DEAO_DCE_URL_PUBLIQUE=
# DEAO_SCRAP_PARTIR_DE_ZERO=false

# Source JOUE de deao_processing (avis lus via l'API et le site TED) — issue #165
# Toutes facultatives (valeurs par défaut ci-dessous). Codes pays séparés par des espaces,
# appliqués à l'acheteur ou au lieu d'exécution.
# JOUE_COUNTRY_CODES=FRA ATF PYF NCL WLF SPM BLM MAF
# JOUE_S3_PREFIX=joue/raw
# JOUE_MAX_WORKERS=4
# Débit vers TED (issue #203) : intervalle minimal entre deux requêtes (tous fils
# confondus) et attente de base avant un nouvel essai après une 429.
# JOUE_INTERVALLE_REQUETES_S=0.6
# JOUE_ATTENTE_429_S=5
# TED_API_URL=https://api.ted.europa.eu/v3
# TED_NOTICE_XML_URL=https://ted.europa.eu/en/notice/{publication_number}/xml
# JOUE_AVIS_URL_TEMPLATE=https://ted.europa.eu/fr/notice/-/detail/{publication_number}
